#!/bin/bash
# AMD GPU Live Monitor for Omarchy

card=""
for d in /sys/class/drm/card*/device; do
  if [[ -f "$d/power_dpm_force_performance_level" ]]; then
    card="$d"
    break
  fi
done

if [[ -z "$card" ]]; then
  echo "Fehler: Keine AMD GPU unter /sys/class/drm/ gefunden."
  exit 1
fi

# Cursor beim Beenden (Strg+C) wieder sichtbar machen
trap 'tput cnorm; echo ""; exit 0' INT TERM
tput civis

while true; do
  dpm=$(cat "$card/power_dpm_force_performance_level" 2>/dev/null)
  fclk=$(awk '$0 ~ /\*/ {print $2}' "$card/pp_dpm_fclk" 2>/dev/null)
  sclk=$(awk '$0 ~ /\*/ {print $2}' "$card/pp_dpm_sclk" 2>/dev/null)
  mclk=$(awk '$0 ~ /\*/ {print $2}' "$card/pp_dpm_mclk" 2>/dev/null)
  
  raw_power=$(cat /sys/class/power_supply/BAT0/power_now 2>/dev/null)
  power=$(awk -v p="$raw_power" 'BEGIN {if (p > 0) printf "%.2f W", p / 1000000; else print "N/A"}')
  
  bat_status=$(cat /sys/class/power_supply/BAT0/status 2>/dev/null)
  
  raw_temp=$(cat "$card"/hwmon/hwmon*/temp1_input 2>/dev/null | head -n1)
  temp=$(awk -v t="$raw_temp" 'BEGIN {if (t > 0) printf "%.1f °C", t / 1000; else print "N/A"}')

  # Bildschirm leeren und neu zeichnen
  clear
  echo -e "\033[1;36m=== AMD GPU Live Monitor (Omarchy) ===\033[0m"
  if [[ "$bat_status" == "Discharging" ]]; then
    echo -e "Stromquelle:  \033[1;31mAkku ($bat_status)\033[0m | \033[1;33m$power\033[0m"
  else
    echo -e "Stromquelle:  \033[1;32mNetzteil ($bat_status)\033[0m | \033[1;33m$power\033[0m"
  fi
  echo -e "DPM-Modus:    \033[1;35m$dpm\033[0m"
  echo -e "Temperatur:   $temp"
  echo "--------------------------------------"
  echo -e "FCLK (Bus):   \033[1;32m${fclk:-N/A}\033[0m  (400Mhz | 800Mhz | 1600Mhz)"
  echo -e "MCLK (VRAM):  \033[1;32m${mclk:-N/A}\033[0m  (400Mhz | 800Mhz)"
  echo -e "SCLK (Core):  \033[1;32m${sclk:-N/A}\033[0m  (800Mhz | 1100Mhz | 2700Mhz)"
  echo "--------------------------------------"
  echo "Beenden mit Strg+C (Refresh alle 1s)"
  sleep 1
done
