[Unit]
Description=Desktop notifications for Kanata configuration reloads
After=graphical-session.target kanata.service
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/Work/dotfiles/kanata/kanata-reload-notify.sh
Restart=always
RestartSec=3

[Install]
WantedBy=graphical-session.target
