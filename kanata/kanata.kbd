;; =============================================================================
;; KANATA CONFIGURATION
;; =============================================================================
(defcfg
  process-unmapped-keys yes  ;; Nicht explizit gemappte Tasten normal durchreichen
  concurrent-tap-hold   yes  ;; Pflicht für defchordsv2 (Reload-Chord)
)

;; -----------------------------------------------------------------------------
;; GLOBAL CHORDS
;; -----------------------------------------------------------------------------
(defchordsv2
  ;; Beide Shift-Tasten gleichzeitig = Konfiguration neu laden
  (lshift rshift) lrld 150 all-released ()
)

;; -----------------------------------------------------------------------------
;; ALIASES
;; -----------------------------------------------------------------------------
(defalias
  ;; Modifier & Navigation Toggles
  caps (tap-hold-press 200 200 esc lctl)
  ;; Layer sofort beim Drücken (kein tap-hold-Wartezustand, sonst hängt die Taste davor);
  ;; Leerzeichen beim Loslassen, siehe spc-alone
  spc (multi (layer-while-held space) (on-release tap-vkey spc-alone))
  nav (layer-while-held nav)

  ;; Deutsche Umlaute (benötigt Host-Layout: us(altgr-intl))
  ä   AG-q
  ü   AG-y
  ö   AG-p
  ß   AG-s
)

;; -----------------------------------------------------------------------------
;; VIRTUAL KEYS
;; -----------------------------------------------------------------------------
(defvirtualkeys
  ;; Leerzeichen nur, wenn Space die zuletzt gedrückte Taste war (Layer nicht benutzt)
  ;; Recency 2, weil die Aktivierung dieser virtuellen Taste selbst auf Platz 1 steht
  spc-alone (switch ((input-history real spc 2)) spc break)
)

;; -----------------------------------------------------------------------------
;; PHYSICAL MATRIX (defsrc)
;; -----------------------------------------------------------------------------
(defsrc
  1     2     3     4     5     6     7     8     9     0     -     =
  caps
  spc
  lctl  lalt  lmet  ralt  rmet
  h     j     k     l
  a     u     o     s
  n     m     /
  f
)

;; -----------------------------------------------------------------------------
;; BASE LAYER
;; -----------------------------------------------------------------------------
(deflayer base
  _     _     _     _     _     _     _     _     _     _     _     _
  @caps
  @spc
  f14   lmet  lalt  rmet  ralt    ;; lctl -> F14 (OmniVoice Diktat); Swap Alt <-> Super (macOS-Style Modifiers)
  _     _     _     _             ;; h j k l
  _     _     _     _             ;; a u o s
  _     _     _                   ;; n m /
  _                               ;; f
)

;; -----------------------------------------------------------------------------
;; SPACE LAYER (Hold Space)
;; -----------------------------------------------------------------------------
(deflayer space
  f1    f2    f3    f4    f5    f6    f7    f8    f9    f10   f11   f12   ;; Zahlenreihe -> F1-F12
  _
  XX                              ;; Space selbst hat im Layer keine eigene Funktion
  _     _     _     _     _       ;; Behält Modifier-Swap bei
  left  down  up    right         ;; Vim-Navigation
  @ä    @ü    @ö    @ß            ;; Umlaute
  spc   bspc  ret                 ;; n -> gehaltenes Space (Push-to-Talk); m -> Backspace, / -> Enter
  @nav                            ;; f halten -> NAV LAYER
)

;; -----------------------------------------------------------------------------
;; NAV LAYER (Hold Space + f)
;; -----------------------------------------------------------------------------
(deflayer nav
  f1    f2    f3    f4    f5    f6    f7    f8    f9    f10   f11   f12   ;; wie SPACE LAYER
  _
  XX
  _     _     _     _     _       ;; Behält Modifier-Swap bei
  home  pgdn  pgup  end           ;; h j k l -> Pos1, Bild runter, Bild hoch, Ende
  @ä    @ü    @ö    @ß            ;; wie SPACE LAYER
  spc   bspc  ret                 ;; wie SPACE LAYER
  XX
)
