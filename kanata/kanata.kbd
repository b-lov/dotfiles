;; =============================================================================
;; KANATA CONFIGURATION
;; =============================================================================

(defcfg
  process-unmapped-keys yes  ;; Nicht explizit gemappte Tasten normal durchreichen
  concurrent-tap-hold   yes  ;; Zuverlaessiges Erkennen bei schnellem Tippen
)

;; -----------------------------------------------------------------------------
;; GLOBAL CHORDS
;; -----------------------------------------------------------------------------
(defchordsv2
  ;; Beide Shift-Tasten gleichzeitig = Konfiguration neu laden
  (lshift rshift) lrld 150 all-released ()
)

;; -----------------------------------------------------------------------------
;; ALIASES
;; -----------------------------------------------------------------------------
(defalias
  ;; Modifier & Navigation Toggles
  caps (tap-hold-press 200 200 esc lctl)
  spc (tap-hold-press 0 65535 spc (layer-toggle space))

  ;; Deutsche Umlaute (benoetigt Host-Layout: us(altgr-intl))
  ä   (fork AG-q AG-S-q (lsft rsft))
  ü   (fork AG-y AG-S-y (lsft rsft))
  ö   (fork AG-p AG-S-p (lsft rsft))
  ß   AG-s  ;; mit Shift: § (Paragraphenzeichen)
)

;; -----------------------------------------------------------------------------
;; PHYSICAL MATRIX (defsrc)
;; -----------------------------------------------------------------------------
(defsrc
  1     2     3     4     5     6     7     8     9     0     -     =
  caps
  spc
  lctl  lalt  lmet        ralt  rmet
  h     j     k     l
  a     u     o     s
  m     /
)

;; -----------------------------------------------------------------------------
;; BASE LAYER
;; -----------------------------------------------------------------------------
(deflayer base
  _     _     _     _     _     _     _     _     _     _     _     _
  @caps
  @spc
  f14   lmet  lalt        rmet  ralt    ;; lctl -> F14 (OmniVoice Diktat); Swap Alt <-> Super (macOS-Style Modifiers)
  _     _     _     _             ;; h j k l
  _     _     _     _             ;; a u o s
  _     _                         ;; m /
)

;; -----------------------------------------------------------------------------
;; SPACE LAYER (Hold Space)
;; -----------------------------------------------------------------------------
(deflayer space
  f1    f2    f3    f4    f5    f6    f7    f8    f9    f10   f11   f12   ;; Zahlenreihe -> F1-F12
  _
  XX                              ;; Verhindert Repeat der Leertaste beim Halten
  _     _     _           _     _       ;; Behaelt Modifier-Swap bei
  left  down  up    right         ;; Vim-Navigation
  @ä    @ü    @ö    @ß            ;; Umlaute
  bspc  ret                       ;; Textbearbeitung (m -> Backspace, / -> Enter)
)
